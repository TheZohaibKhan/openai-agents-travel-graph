# TEMPLATE ONLY. Do not put real keys in this file.
# On Streamlit Community Cloud: open your app -> Settings -> Secrets and paste the lines below
# with your real key. For local use you do NOT need this file; your .env file is used instead.

GEMINI_API_KEY = "paste-your-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Protects your free quota and visitors' privacy on a public website:
PUBLIC_MODE = "true"          # nothing is stored on the server, "Saved trips" is hidden
DAILY_TRIP_LIMIT = "40"       # max trips per day for all visitors together
SESSION_TRIP_LIMIT = "5"      # max trips per visitor per visit

# --- Optional: live flight & hotel prices (https://serpapi.com) ---
# SERPAPI_API_KEY = "paste-your-serpapi-key-here"
# LIVE_PRICES_DAILY_LIMIT = "4"      # lookups per day for all visitors together (2 searches each)

# --- Optional: "Create a shareable link" (needs the table from supabase_schema.sql) ---
# ENABLE_SHARING = "true"
# SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# SUPABASE_KEY = "sb_secret_..."          # the SECRET key, never the publishable one
# APP_URL = "https://your-app.streamlit.app"
# SHARE_SESSION_LIMIT = "5"
