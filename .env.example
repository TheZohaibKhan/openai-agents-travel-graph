# AI Travel Planner - settings
# 1) Copy this file to a new file named exactly:  .env
# 2) Put your real key after GEMINI_API_KEY=   (no quotes, no spaces)
# Never share or upload the .env file. It is already ignored by git.

# --- Required ---------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey   (new keys start with "AQ." - that is normal)
GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------
# Flash-Lite models have a much bigger free daily limit than the bigger Flash models.
GEMINI_MODEL=gemini-3.5-flash-lite
# Extra models to try automatically if the one above runs out of quota (comma separated):
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
DEFAULT_CURRENCY=USD

# --- Optional: also save plans to Supabase ------------------------------------
# Needs:  pip install supabase   and the table from supabase_schema.sql
SAVE_TO_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=
